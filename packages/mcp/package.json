{
  "name": "@fluxnative/ui-mcp",
  "version": "0.0.1",
  "description": "An MCP server over the FluxNative UI catalog layer: search and read recipes with their props and evidence, fetch the model index and the design rules, and validate a screen against the template dialect before it lands in a template.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fluxnative-app/fluxnative-ui.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/fluxnative-app/fluxnative-ui#readme",
  "bugs": "https://github.com/fluxnative-app/fluxnative-ui/issues",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "fluxnative-ui-mcp": "src/bin.js"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/graders/fixtures"
  ],
  "scripts": {
    "test": "node --test src/*.test.ts src/graders/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fluxnative/catalog": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "typescript": "~6.0.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
